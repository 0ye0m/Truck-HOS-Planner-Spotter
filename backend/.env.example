# ── TruckHOS Planner — backend environment ─────────────────────────
# Copy to .env and adjust. NEVER commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL in production; SQLite is used when unset)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS (comma-separated origins of the frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For debugging only:
# CORS_ALLOW_ALL_ORIGINS=1

# Free/open map stack (OpenStreetMap)
GEOCODING_API_URL=https://nominatim.openstreetmap.org
ROUTING_API_URL=https://router.project-osrm.org
GEOCODING_USER_AGENT=TruckHOSPlanner/1.0 (your-contact@example.com)
GEOCODING_MIN_INTERVAL_SECONDS=1.1
GEOCODING_TIMEOUT_SECONDS=10
ROUTING_TIMEOUT_SECONDS=20
